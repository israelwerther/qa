{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Sync QA Tools",
      "type": "shell",
      "command": "git -C .ai_qa_acervo pull --quiet origin main 2>/dev/null && bash .ai_qa_acervo/scripts/setup-tasks.sh --silent 2>/dev/null || true",
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": []
    },
    {
      "label": "Django: Runserver",
      "type": "shell",
      "command": "./venv/bin/python ./manage.py runserver",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Celery: Worker",
      "type": "shell",
      "command": "./venv/bin/celery -A fiscallizeon worker -l info -Q celery,merge,answer-sheet-print,exam-print,omr-import,omr-export,celery-priority,celery-integration",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "PDF Service",
      "type": "shell",
      "command": "./.ai_qa_acervo/scripts/start-pdf-service.sh",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "Start All Services",
      "dependsOn": [
        "Sync QA Tools",
        "Django: Runserver",
        "Celery: Worker",
        "PDF Service"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
